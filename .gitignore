# ── Outputs gerados em runtime ────────────────────────────────────────────────
data/output/*.csv
data/output/*.html
data/output/crops/*
data/output/preprocessed/*
!data/output/crops/.gitkeep
!data/output/preprocessed/.gitkeep

# ── Lista de placas roubadas (gerenciada localmente) ──────────────────────────
data/stolen_plates.txt

# ── Dataset de imagens ────────────────────────────────────────────────────────
data/input/*
!data/input/.gitkeep

data/output/*
!data/output/.gitkeep
!data/output/crops/
!data/output/preprocessed/
data/output/crops/*
!data/output/crops/.gitkeep
data/output/preprocessed/*
!data/output/preprocessed/.gitkeep

# ── Modelos quantizados gerados localmente ────────────────────────────────────
# O modelo base (.pt e .onnx) fica versionado.
# Modelos gerados por tools/quantize*.py ficam apenas localmente.
models/*_int8.onnx
models/*_static_int8.onnx
!models/.gitkeep